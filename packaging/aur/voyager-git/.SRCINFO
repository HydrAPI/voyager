pkgbase = voyager-git
	pkgdesc = A fast graphical file manager (development version from master)
	pkgver = 1.1.0.r1.g9abc5dd
	pkgrel = 1
	url = https://github.com/HydrAPI/voyager
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = cargo
	makedepends = git
	makedepends = gettext
	depends = at-spi2-core
	depends = cairo
	depends = gdk-pixbuf2
	depends = glib2
	depends = glibc
	depends = gtk3
	depends = gvfs
	depends = hicolor-icon-theme
	depends = libgcc
	depends = pango
	optdepends = ffmpegthumbnailer: video thumbnails
	optdepends = ffmpeg: video thumbnails without ffmpegthumbnailer
	optdepends = mediainfo: the Media Info tab in Properties
	optdepends = gvfs-mtp: phones and media players over MTP
	optdepends = gvfs-gphoto2: cameras
	optdepends = gvfs-smb: Windows and Samba network shares
	optdepends = gvfs-wsdd: finding Windows computers in the network
	optdepends = gvfs-dnssd: finding computers in the network (Avahi)
	optdepends = engrampa: creating and extracting archives
	optdepends = file-roller: creating and extracting archives
	optdepends = xarchiver: creating and extracting archives
	optdepends = xterm: Open in Terminal, if no other terminal is installed
	provides = voyager
	conflicts = voyager
	options = !debug
	source = voyager::git+https://github.com/HydrAPI/voyager.git#branch=master
	sha256sums = SKIP

pkgname = voyager-git
